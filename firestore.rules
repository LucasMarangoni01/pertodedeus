rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Logic Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    // IDs must be reasonably sized and safe
    function isValidId(id) { return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Users Collection ---
    match /users/{userId} {
      // Profiles are accessible if signed in, but sensitive data (if any) should be guarded
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false; // Prevent scraping all users

      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().streak == 0;

       allow update: if isOwner(userId) 
                     && isValidUser(incoming())
                     && (
                       // Profile Update Action
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'denomination', 'yearsAsChristian', 'bio', 'spiritualLevel', 'streak', 'lastCheckIn', 'bibleVersion', 'isPublic', 'updatedAt', 'readingPlans', 'notifications', 'privacy', 'bibleProgress'])
                     );

      function isValidUser(data) {
        return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
          && (data.denomination == null || (data.denomination is string && data.denomination.size() <= 100))
          && (data.bibleVersion == null || (data.bibleVersion is string && data.bibleVersion.size() <= 20))
          && (data.yearsAsChristian == null || (data.yearsAsChristian is int && data.yearsAsChristian >= 0))
          && (data.isPublic == null || data.isPublic is bool)
          && (data.bio == null || (data.bio is string && data.bio.size() <= 1000))
          && (data.updatedAt == null || data.updatedAt is timestamp)
          && (data.notifications == null || data.notifications is map)
          && (data.privacy == null || data.privacy is map)
          && (data.bibleProgress == null || data.bibleProgress is map)
          && data.spiritualLevel in ['Semente', 'Raiz', 'Árvore', 'Fruto', 'Luz']
          && (data.streak == null || (data.streak is int && data.streak >= 0));
      }

      // --- Private Journal ---
      match /journal/{entryId} {
        allow read: if isOwner(userId);
        
        function isValidJournal(data) {
          return (data.get('userId', '') == userId)
            && (data.get('content', '') is string && data.get('content', '').size() <= 50000)
            && (data.get('mood', 'Em paz') is string && data.get('mood', '').size() <= 50)
            && (data.get('audioUrl', null) == null || (data.audioUrl is string && data.audioUrl.size() <= 2048))
            && (data.get('tags', []) is list && data.get('tags', []).size() <= 20)
            && (data.get('learning', '') is string && data.get('learning', '').size() <= 5000)
            && (data.get('godSpoke', '') is string && data.get('godSpoke', '').size() <= 5000)
            && (data.get('ledToThis', '') is string && data.get('ledToThis', '').size() <= 5000)
            && (data.get('doDifferently', '') is string && data.get('doDifferently', '').size() <= 5000)
            && (data.get('date', '') is string);
        }

        allow create: if isOwner(userId) 
          && isValidId(entryId)
          && isValidJournal(incoming())
          && incoming().createdAt == request.time;

        allow update: if isOwner(userId) 
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mood', 'learning', 'godSpoke', 'tags', 'ledToThis', 'doDifferently', 'audioUrl', 'updatedAt'])
            && (incoming().get('updatedAt', null) == request.time)
          );
        
        allow delete: if isOwner(userId);
      }

      // --- Personalized Devotionals ---
      match /devotionals/{devotionalId} {
        allow read: if isOwner(userId);
        // Devotionals are created by the system/user interaction
        allow create: if isOwner(userId) && incoming().userId == userId && incoming().date is string;
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['userResponse', 'isFavorite']);
      }

      // --- AI Assistant Conversations ---
      match /assistant_conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAssistantConversation(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt', 'lastMessage'])
        );
        allow delete: if isOwner(userId);

        function isValidAssistantConversation(data) {
          return data.title is string && data.title.size() <= 200;
        }

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidAssistantMessage(incoming()) && incoming().createdAt == request.time;
          
          function isValidAssistantMessage(data) {
            return data.role in ['user', 'assistant']
              && data.content is string && data.content.size() > 0 && data.content.size() <= 10000;
          }
        }
      }

      // --- Custom Reading Plans ---
      match /custom_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidReadingPlan(incoming()) 
          && incoming().createdAt == request.time;
          
        allow update: if isOwner(userId) 
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['items', 'completedItems', 'title', 'description', 'updatedAt'])
            && (incoming().get('updatedAt', null) == request.time)
          );

        function isValidReadingPlan(data) {
          return data.get('userId', '') == userId
            && data.get('title', '') is string && data.get('title', '').size() <= 200
            && data.get('items', []) is list && data.get('items', []).size() <= 366;
        }
      }

      // --- Spiritual Struggles Tracker ---
      match /struggles/{struggleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidStruggle(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['totalFalls', 'lastFall', 'totalVictories', 'lastVictory', 'sinType', 'biblicalAdvice', 'verse', 'updatedAt'])
          && (incoming().get('updatedAt', null) == request.time)
        );
        allow delete: if isOwner(userId);

        function isValidStruggle(data) {
          return data.get('userId', '') == userId
            && data.get('sinType', '') is string && data.get('sinType', '').size() <= 100
            && data.get('totalFalls', 0) is int 
            && data.get('totalVictories', 0) is int;
        }
      }

      // --- Struggle History ---
      match /struggle_history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && incoming().userId == userId
          && incoming().sinType is string && incoming().sinType.size() <= 100
          && incoming().type in ['fall', 'victory']
          && incoming().createdAt == request.time;
        allow delete: if isOwner(userId);
      }

      // --- Spiritual Agenda / Calendar ---
      match /calendar_events/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCalendarEvent(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'startTime', 'endTime', 'date', 'category', 'isDone', 'updatedAt'])
          && (incoming().get('updatedAt', null) == request.time)
        );
        allow delete: if isOwner(userId);

        function isValidCalendarEvent(data) {
          return data.get('userId', '') == userId
            && data.get('title', '') is string && data.get('title', '').size() <= 200
            && data.get('category', 'Oração') in ['Oração', 'Compromisso', 'Evento', 'Jejum', 'Ministério'];
        }
      }
    }

    // --- Prayer Requests (Global/Shared) ---
    match /prayer_requests/{requestId} {
      // Get: Owner or Public
      allow get: if isSignedIn() && (isOwner(existing().userId) || existing().isPublic == true);
      
      // List: Must explicitly filter by userId or isPublic
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      
      allow create: if isSignedIn() 
                    && isOwner(incoming().userId) 
                    && isValidPrayer(incoming()) 
                    && incoming().createdAt == request.time
                    && incoming().intercessorCount == 0;

      allow update: if isSignedIn() && (
        // Action: Owner Update
        (isOwner(existing().userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'urgency', 'status', 'testimony', 'isPublic', 'updatedAt'])
          && (incoming().get('updatedAt', null) == request.time)
        )) ||
        // Action: Community Intercession (Increment only)
        (existing().isPublic == true && 
         incoming().diff(existing()).affectedKeys().hasOnly(['intercessorCount']) && 
         incoming().intercessorCount == existing().intercessorCount + 1)
      );

      allow delete: if isOwner(existing().userId);

      function isValidPrayer(data) {
        return data.userId is string
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.status in ['Em oração', 'Respondido', 'Arquivado']
          && (data.status != 'Respondido' || (data.testimony is string && data.testimony.size() > 0))
          && data.urgency in ['Baixa', 'Média', 'Alta'];
      }
    }

    // --- Global Testimonials (Mural) ---
    match /testimonials/{testimonyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidTestimony(incoming());
      allow update: if isSignedIn() && (
        // Permitir atualização de likes
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
        incoming().likes == existing().likes + 1) ||
        // Permitir edição pelo dono
        (isOwner(existing().userId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']) &&
         incoming().updatedAt == request.time)
      );
      allow delete: if isOwner(existing().userId);

      function isValidTestimony(data) {
        return data.userId is string
          && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
          && data.title is string && data.title.size() <= 200
          && data.content is string && data.content.size() > 0 && data.content.size() <= 20000;
      }
    }

    // --- Global Chat (Real-time) ---
    match /global_chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isOwner(incoming().userId)
                    && isValidChatMessage(incoming())
                    && incoming().createdAt == request.time;
      
      allow update: if isOwner(existing().userId) 
                    && incoming().updatedAt == request.time
                    && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000
                    && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
                    );
                    
      allow delete: if isOwner(existing().userId);

      function isValidChatMessage(data) {
        return data.userId is string
          && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
          && data.text is string && data.text.size() > 0 && data.text.size() <= 2000;
      }
    }
  }
}
