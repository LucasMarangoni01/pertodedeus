{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role" },
        "denomination": { "type": "string", "description": "Church denomination" },
        "bibleVersion": { "type": "string", "enum": ["NVI", "ARA", "NVT", "NAA", "NTLH"], "description": "Preferred Bible translation" },
        "yearsAsChristian": { "type": "number", "description": "Time as a Christian" },
        "spiritualLevel": { "type": "string", "enum": ["Semente", "Raiz", "Árvore", "Fruto", "Luz"], "description": "Gamified spiritual level" },
        "experience": { "type": "integer", "description": "Total XP earned" },
        "totalChaptersRead": { "type": "integer", "description": "Total Bible chapters read" },
        "totalPrayers": { "type": "integer", "description": "Total prayers registered" },
        "totalDevotionals": { "type": "integer", "description": "Total devotionals completed" },
        "totalFaithDays": { "type": "integer", "description": "Total unique days of faith activity" },
        "lastFaithDay": { "type": "string", "description": "Date of last faith day credit (YYYY-MM-DD)" },
        "ministerialBalance": {
          "type": "object",
          "properties": {
            "oracao": { "type": "integer" },
            "palavra": { "type": "integer" },
            "caridade": { "type": "integer" },
            "jejum": { "type": "integer" },
            "louvor": { "type": "integer" }
          },
          "description": "Ministry balance metrics for the radar chart (0-100)"
        },
        "streak": { "type": "integer", "description": "Consecutive days of activity" },
        "lastCheckIn": { "type": "string", "format": "date-time", "description": "Last activity timestamp" },
        "bio": { "type": "string", "description": "Short bio or favorite verse" },
        "fcmTokens": { "type": "array", "items": { "type": "string" }, "description": "List of FCM tokens for push notifications" },
        "notifications": {
          "type": "object",
          "properties": {
            "dailyDevotional": { "type": "boolean" },
            "prayerRequests": { "type": "boolean" },
            "communityActivity": { "type": "boolean" }
          },
          "description": "User notification preferences"
        },
        "privacy": {
          "type": "object",
          "properties": {
            "showProfile": { "type": "boolean" },
            "showStreak": { "type": "boolean" },
            "showStruggles": { "type": "boolean" }
          },
          "description": "User privacy preferences"
        },
        "bibleProgress": {
          "type": "object",
          "properties": {
            "book": { "type": "string" },
            "bookId": { "type": "integer" },
            "chapter": { "type": "integer" },
            "verse": { "type": "integer" },
            "version": { "type": "string" },
            "updatedAt": { "type": "string", "format": "date-time" }
          },
          "description": "Last read position in the Bible"
        }
      },
      "required": ["displayName", "spiritualLevel", "streak"]
    },
    "PrayerRequest": {
      "title": "Prayer Request",
      "description": "Individual prayer requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Subject of the prayer" },
        "description": { "type": "string", "description": "Detailed description" },
        "category": { "type": "string", "description": "Saúde, Família, etc." },
        "urgency": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "status": { "type": "string", "enum": ["Em oração", "Respondido", "Arquivado"] },
        "testimony": { "type": "string", "description": "How God answered" },
        "isPublic": { "type": "boolean", "description": "Visible to community" },
        "createdAt": { "type": "string", "format": "date-time" },
        "intercessorCount": { "type": "integer", "description": "Number of people praying" }
      },
      "required": ["userId", "title", "status", "createdAt"]
    },
    "JournalEntry": {
      "title": "Spiritual Journal",
      "description": "Daily spiritual journal entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string" },
        "mood": { "type": "string", "description": "Grato, Em paz, etc." },
        "learning": { "type": "string", "description": "What I learned" },
        "godSpoke": { "type": "string", "description": "How God spoke to me" },
        "ledToThis": { "type": "string", "description": "Context what led to feelings" },
        "doDifferently": { "type": "string", "description": "Plans for change" },
        "audioUrl": { "type": "string", "description": "URL to recorded audio file" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "createdAt"]
    },
    "Devotional": {
      "title": "Daily Devotional",
      "description": "History of generated devotionals for the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "verse": { "type": "string" },
        "reflection": { "type": "string" },
        "question": { "type": "string" },
        "userResponse": { "type": "string" },
        "prayer": { "type": "string" },
        "isFavorite": { "type": "boolean" }
      },
      "required": ["userId", "date", "title"]
    },
    "ChatMessage": {
      "title": "Global Chat Message",
      "description": "Message in the global community chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    },
    "Testimonial": {
      "title": "Community Testimonial",
      "description": "Public testimonials of faith",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "likes", "createdAt"]
    },
    "ReadingPlan": {
      "title": "Custom Reading Plan",
      "description": "User-defined custom reading plans",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "durationDays": { "type": "integer" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "day": { "type": "integer" },
              "passage": { "type": "string" },
              "isCompleted": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "totalItems": { "type": "integer" },
        "completedItems": { "type": "integer" }
      },
      "required": ["userId", "title", "createdAt", "items"]
    },
    "AssistantConversation": {
      "title": "AI Assistant Conversation",
      "description": "A specific conversation thread with the AI assistant",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Auto-generated or user-defined title for the conversation" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "AssistantMessage": {
      "title": "AI Assistant Message",
      "description": "Messages exchanged between the user and the AI assistant",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "Struggle": {
      "title": "Struggle Tracker",
      "description": "Tracking personal struggles and sins with biblical guidance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sinType": { "type": "string", "description": "Type of struggle (e.g., Pride, Anger)" },
        "totalFalls": { "type": "integer", "description": "Number of times recorded a fall" },
        "lastFall": { "type": "string", "format": "date-time" },
        "totalVictories": { "type": "integer", "description": "Number of times recorded a victory" },
        "lastVictory": { "type": "string", "format": "date-time" },
        "biblicalAdvice": { "type": "string", "description": "Message to help overcome" },
        "verse": { "type": "string", "description": "Supporting Bible verse" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sinType", "totalFalls", "createdAt"]
    },
    "StruggleHistory": {
      "title": "Struggle History Log",
      "description": "Log of individual falls or victories for history tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sinType": { "type": "string" },
        "type": { "type": "string", "enum": ["fall", "victory"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sinType", "type", "createdAt"]
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "User scheduled events and reminders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "date": { "type": "string", "description": "YYYY-MM-DD for easier filtering" },
        "category": { "type": "string", "enum": ["Oração", "Compromisso", "Evento", "Jejum", "Ministério"] },
        "isDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "startTime", "date", "category"]
    },
    "BibleMarker": {
      "title": "Bible Verse Marker",
      "description": "Marked/Highlight verses in the Bible",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "book": { "type": "string" },
        "chapter": { "type": "integer" },
        "verse": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "book", "chapter", "verse", "createdAt"]
    },
    "BibleNote": {
      "title": "Bible Verse Note",
      "description": "Personal notes for specific Bible verses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "book": { "type": "string" },
        "chapter": { "type": "integer" },
        "verse": { "type": "integer" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "book", "chapter", "verse", "text", "createdAt"]
    },
    "Announcement": {
      "title": "Global Announcement",
      "description": "Message from admins to all users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "alert", "welcome"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "content", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles and statistics"
    },
    "/prayer_requests/{requestId}": {
      "schema": "PrayerRequest",
      "description": "Global collection of prayer requests"
    },
    "/users/{userId}/journal/{entryId}": {
      "schema": "JournalEntry",
      "description": "Private spiritual journal for each user"
    },
    "/users/{userId}/assistant_conversations/{conversationId}": {
      "schema": "AssistantConversation",
      "description": "Conversation threads with the AI assistant"
    },
    "/users/{userId}/assistant_conversations/{conversationId}/messages/{messageId}": {
      "schema": "AssistantMessage",
      "description": "Messages within a specific conversation"
    },
    "/users/{userId}/devotionals/{devotionalId}": {
      "schema": "Devotional",
      "description": "Personalized daily devotionals"
    },
    "/global_chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time global chat messages"
    },
    "/testimonials/{testimonyId}": {
      "schema": "Testimonial",
      "description": "Public testimonials shared by users"
    },
    "/users/{userId}/custom_plans/{planId}": {
      "schema": "ReadingPlan",
      "description": "Custom reading plans created by the user"
    },
    "/users/{userId}/struggles/{struggleId}": {
      "schema": "Struggle",
      "description": "Private tracking of personal struggles and spiritual growth"
    },
    "/users/{userId}/struggle_history/{historyId}": {
      "schema": "StruggleHistory",
      "description": "History of specific struggle events (falls/victories)"
    },
    "/users/{userId}/calendar_events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "User's personal spiritual agenda"
    },
    "/users/{userId}/marcadores/{markerId}": {
      "schema": "BibleMarker",
      "description": "Marked verses for highlighting"
    },
    "/users/{userId}/notas/{noteId}": {
      "schema": "BibleNote",
      "description": "User notes on specific verses"
    },
    "/global_announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official admin communication"
    }
  }
}
