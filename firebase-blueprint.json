{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Extended user profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "denomination": { "type": "string", "description": "Church denomination" },
        "yearsAsChristian": { "type": "number", "description": "Time as a Christian" },
        "spiritualLevel": { "type": "string", "enum": ["Semente", "Raiz", "Árvore", "Fruto", "Luz"], "description": "Gamified spiritual level" },
        "streak": { "type": "integer", "description": "Consecutive days of activity" },
        "lastCheckIn": { "type": "string", "format": "date-time", "description": "Last activity timestamp" },
        "bio": { "type": "string", "description": "Short bio or favorite verse" },
        "fcmTokens": { "type": "array", "items": { "type": "string" }, "description": "List of FCM tokens for push notifications" }
      },
      "required": ["displayName", "spiritualLevel", "streak"]
    },
    "PrayerRequest": {
      "title": "Prayer Request",
      "description": "Individual prayer requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Subject of the prayer" },
        "description": { "type": "string", "description": "Detailed description" },
        "category": { "type": "string", "description": "Saúde, Família, etc." },
        "urgency": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "status": { "type": "string", "enum": ["Em oração", "Respondido", "Arquivado"] },
        "testimony": { "type": "string", "description": "How God answered" },
        "isPublic": { "type": "boolean", "description": "Visible to community" },
        "createdAt": { "type": "string", "format": "date-time" },
        "intercessorCount": { "type": "integer", "description": "Number of people praying" }
      },
      "required": ["userId", "title", "status", "createdAt"]
    },
    "JournalEntry": {
      "title": "Spiritual Journal",
      "description": "Daily spiritual journal entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "content": { "type": "string" },
        "mood": { "type": "string", "description": "Grato, Em paz, etc." },
        "learning": { "type": "string", "description": "What I learned" },
        "godSpoke": { "type": "string", "description": "How God spoke to me" },
        "ledToThis": { "type": "string", "description": "Context what led to feelings" },
        "doDifferently": { "type": "string", "description": "Plans for change" },
        "audioUrl": { "type": "string", "description": "URL to recorded audio file" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "createdAt"]
    },
    "Devotional": {
      "title": "Daily Devotional",
      "description": "History of generated devotionals for the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "verse": { "type": "string" },
        "reflection": { "type": "string" },
        "question": { "type": "string" },
        "userResponse": { "type": "string" },
        "prayer": { "type": "string" },
        "isFavorite": { "type": "boolean" }
      },
      "required": ["userId", "date", "title"]
    },
    "ChatMessage": {
      "title": "Global Chat Message",
      "description": "Message in the global community chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text", "createdAt"]
    },
    "Testimonial": {
      "title": "Community Testimonial",
      "description": "Public testimonials of faith",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "likes", "createdAt"]
    },
    "ReadingPlan": {
      "title": "Custom Reading Plan",
      "description": "User-defined custom reading plans",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "durationDays": { "type": "integer" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "day": { "type": "integer" },
              "passage": { "type": "string" },
              "isCompleted": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "totalItems": { "type": "integer" },
        "completedItems": { "type": "integer" }
      },
      "required": ["userId", "title", "createdAt", "items"]
    },
    "AssistantMessage": {
      "title": "AI Assistant Message",
      "description": "Messages exchanged between the user and the AI assistant",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "Struggle": {
      "title": "Struggle Tracker",
      "description": "Tracking personal struggles and sins with biblical guidance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sinType": { "type": "string", "description": "Type of struggle (e.g., Pride, Anger)" },
        "totalFalls": { "type": "integer", "description": "Number of times recorded a fall" },
        "lastFall": { "type": "string", "format": "date-time" },
        "biblicalAdvice": { "type": "string", "description": "Message to help overcome" },
        "verse": { "type": "string", "description": "Supporting Bible verse" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sinType", "totalFalls", "createdAt"]
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "User scheduled events and reminders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "date": { "type": "string", "description": "YYYY-MM-DD for easier filtering" },
        "category": { "type": "string", "enum": ["Oração", "Compromisso", "Evento", "Jejum", "Ministério"] },
        "isDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "startTime", "date", "category"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles and statistics"
    },
    "/prayer_requests/{requestId}": {
      "schema": "PrayerRequest",
      "description": "Global collection of prayer requests"
    },
    "/users/{userId}/journal/{entryId}": {
      "schema": "JournalEntry",
      "description": "Private spiritual journal for each user"
    },
    "/users/{userId}/assistant_chat/{messageId}": {
      "schema": "AssistantMessage",
      "description": "Conversation history with the AI assistant"
    },
    "/users/{userId}/devotionals/{devotionalId}": {
      "schema": "Devotional",
      "description": "Personalized daily devotionals"
    },
    "/global_chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time global chat messages"
    },
    "/testimonials/{testimonyId}": {
      "schema": "Testimonial",
      "description": "Public testimonials shared by users"
    },
    "/users/{userId}/custom_plans/{planId}": {
      "schema": "ReadingPlan",
      "description": "Custom reading plans created by the user"
    },
    "/users/{userId}/struggles/{struggleId}": {
      "schema": "Struggle",
      "description": "Private tracking of personal struggles and spiritual growth"
    },
    "/users/{userId}/calendar_events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "User's personal spiritual agenda"
    }
  }
}
